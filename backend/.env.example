# Vegist Backend Environment Configuration
SECRET_KEY=django-insecure-vegist-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend.onrender.com

# Database (PostgreSQL URL for Render/Railway/Local, falls back to sqlite3 if unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vegist_db

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vegist-store.vercel.app

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Seed Admin Account
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@vegist.com
SUPERUSER_PASSWORD=VegistAdmin2026!
